# Storyblok — required
# Preview token from Storyblok: Settings → Access tokens
NEXT_PUBLIC_STORYBLOK_ACCESS_TOKEN=your_preview_token_here
# draft (visual editor / preview) or published (production)
STORYBLOK_VERSION=draft

# Storyblok — optional (defaults shown)
NEXT_PUBLIC_STORYBLOK_API_GATE=https://api.storyblok.com/v2/cdn

# Site URLs — used for canonical/OG metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DOMAIN=http://localhost:3000

# On-demand revalidation webhook secret (/api/revalidate?secret=...)
SB_WEBHOOK_REVALIDATE_SECRET=change_me
