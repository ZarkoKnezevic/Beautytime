# Storyblok — required (server-only, never NEXT_PUBLIC_)
# Production: the *Public* token from Storyblok → Settings → Access tokens
# (published content only). Development may use the Preview token here too.
STORYBLOK_ACCESS_TOKEN=your_token_here
# Preview token: used only for draft content (visual editor / live preview).
STORYBLOK_PREVIEW_TOKEN=your_preview_token_here
# draft (visual editor / preview) or published (production). Defaults to
# published in production builds and draft in development.
STORYBLOK_VERSION=draft

# Storyblok — optional (defaults shown)
NEXT_PUBLIC_STORYBLOK_API_GATE=https://api.storyblok.com/v2/cdn

# Site URLs — used for canonical/OG metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DOMAIN=http://localhost:3000

# On-demand revalidation webhook secret (/api/revalidate?secret=...)
SB_WEBHOOK_REVALIDATE_SECRET=change_me
